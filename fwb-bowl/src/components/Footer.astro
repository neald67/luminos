---
import Icon from './Icon.astro';
import RainbowStrip from './RainbowStrip.astro';
import { business, cityLine, hoursNote } from '../data/site';
import { hoursRows } from '../lib/time';

const rows = hoursRows();
const year = new Date().getFullYear();
---

<footer class="site-footer night grain">
  <RainbowStrip />
  <div class="wrap footer-grid">
    <section aria-labelledby="footer-visit">
      <h2 id="footer-visit" class="footer-h">Visit</h2>
      <p class="footer-name">{business.name}</p>
      <p>
        <a href={business.mapsUrl} class="footer-link">
          <Icon name="pin" />
          <span>
            {business.address.street}<br />{cityLine}
            <span class="visually-hidden"> (opens Google Maps)</span>
          </span>
        </a>
      </p>
      <p>
        <a href={business.phoneHref} class="footer-link footer-phone">
          <Icon name="phone" />
          <span>{business.phone}</span>
        </a>
      </p>
      <p>
        <a href={business.facebookUrl} class="footer-link">
          <Icon name="facebook" />
          <span>Find us on Facebook</span>
        </a>
      </p>
    </section>

    <section aria-labelledby="footer-hours">
      <h2 id="footer-hours" class="footer-h">Hours</h2>
      <table class="hours">
        <caption class="visually-hidden">Weekly hours</caption>
        <tbody>
          {
            rows.map((r) => (
              <tr>
                <th scope="row">{r.day}</th>
                <td>{r.range}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="fine-print">{hoursNote}</p>
    </section>

    <section aria-labelledby="footer-good">
      <h2 id="footer-good" class="footer-h">Good to know</h2>
      <ul class="footer-list">
        <li>
          <Icon name="gift" />
          <span>Gift cards available. Call <a href={business.phoneHref}>{business.phone}</a> for details.</span>
        </li>
        <li>
          <Icon name="card" />
          <span>We accept {business.payments.slice(0, -1).join(', ')} and {business.payments.at(-1)}.</span>
        </li>
        <li>
          <Icon name="phone" />
          <span>Please call for lane availability.</span>
        </li>
      </ul>
    </section>
  </div>

  <div class="wrap footer-base">
    <p>© {year} {business.name}. Prices and hours subject to change.</p>
    <ul class="footer-legal">
      <li><a href="/accessibility/">Accessibility statement</a></li>
      <li><a href="/privacy/">Privacy policy</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--night);
    padding-bottom: var(--space-l);
    font-size: var(--step--1);
  }
  .footer-grid {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    padding-block: var(--space-2xl) var(--space-xl);
  }
  .footer-h {
    font-size: var(--step-1);
    margin-bottom: var(--space-m);
  }
  .footer-name {
    font-weight: 800;
    font-size: var(--step-0);
    margin-bottom: var(--space-s);
  }
  .footer-link {
    display: inline-flex;
    gap: 0.6rem;
    align-items: flex-start;
    color: var(--on-night);
    min-height: 2.75rem;
    padding-block: 0.25rem;
  }
  .footer-link :global(svg),
  .footer-list :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    margin-top: 0.15rem;
    color: var(--logo-yellow);
  }
  .footer-phone {
    font-size: var(--step-1);
    font-weight: 800;
  }
  .footer-link :global(span) {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.2em;
  }
  .site-footer p {
    margin-bottom: var(--space-xs);
  }
  .hours {
    max-width: 22rem;
  }
  .hours th,
  .hours td {
    padding: 0.35rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }
  .hours th {
    font-weight: 700;
    padding-right: 1rem;
  }
  .hours td {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .footer-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-s);
  }
  .footer-list li {
    display: flex;
    gap: 0.6rem;
  }
  .footer-list a {
    color: var(--on-night);
  }
  .footer-base {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-l);
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-l);
    border-top: 1px solid rgb(255 255 255 / 0.14);
    color: var(--on-night-soft);
  }
  .footer-base p {
    margin: 0;
  }
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-l);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-legal a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--site-cyan);
  }
</style>

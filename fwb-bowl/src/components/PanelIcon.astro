---
// An icon on a tilted color panel with a black outline, like the letter tiles in the logo.
import Icon from './Icon.astro';
type IconName = Parameters<typeof Icon>[0]['name'];
interface Props {
  icon: IconName;
  color: 'orange' | 'yellow' | 'lime' | 'green' | 'blue' | 'red' | 'purple';
  tilt?: number;
}
const { icon, color, tilt = -4 } = Astro.props;
const dark = ['blue', 'red', 'purple'].includes(color);
---

<span class="panel-icon" style={`--panel: var(--logo-${color}); --tilt: ${tilt}deg; color: ${dark ? '#fff' : 'var(--ink)'}`} aria-hidden="true">
  <Icon name={icon} />
</span>

<style>
  .panel-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: var(--panel-size, 3.25rem);
    height: var(--panel-size, 3.25rem);
    border: 3px solid #08090b;
    border-radius: 6px;
    background: var(--panel);
    transform: rotate(var(--tilt));
  }
  .panel-icon :global(svg) {
    width: 55%;
    height: 55%;
  }
</style>
